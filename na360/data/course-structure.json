      "title": "Fundamentals of Network Devices",
      "clos": ["CLO1", "CLO2"],
      "domains": ["Network Administration Fundamentals", "Network Device Infrastructure"],
      "subtopics": [
        { "code": "2.1", "title": "Apply Virtual LAN concept by identifying VLAN usage on network switches",
          "detail": ["Default VLAN", "Data VLAN", "Voice VLAN", "Native VLAN", "Management VLAN", "Reserved VLAN", "VLAN trunking and its purpose"] },
        { "code": "2.2", "title": "Apply basic routing protocols in small network environment",
          "detail": ["Static Routing Protocol", "Dynamic Routing Protocol — Interior Gateway Protocols (RIP, OSPF, EIGRP)", "Exterior Gateway Protocols (BGP)"] },
        { "code": "2.3", "title": "Apply server concepts by identifying server types and usage in small network environment",
          "detail": ["Roles of client and server", "Client and server functions", "Types of server", "Network Operating System architecture", "NOS vs general-purpose OS", "Types of NOS including open-source", "Hardware requirements for NOS"] }
      ]
    },
    {
      "id": "U3",
      "code": "3.0",
      "title": "Network Configuration",
      "clos": ["CLO2"],
      "domains": ["Network Configuration", "Network Troubleshooting"],
      "subtopics": [
        { "code": "3.1", "title": "Construct initial network device configuration in Switch and Router",
          "detail": ["Changing device hostname", "Enable password", "Local authentication", "Line Console access authentication", "Virtual terminal (VTY) access authentication", "Password encryption", "Login Banner", "Save device configuration"] },
        { "code": "3.2", "title": "Construct VLAN and Trunking in Network",
          "detail": ["Creating VLAN", "Assigning Switch Ports to VLAN", "Assigning description to Switch Ports", "Configure the Management Interface on VLAN", "Trunk Ports configuration", "Inter-VLAN routing configuration on a router"] },
        { "code": "3.3", "title": "Implement network routing in small network environment",
          "detail": ["Static Routing Protocol", "RIPv2 configuration"] },
        { "code": "3.4", "title": "Construct DHCP configuration",
          "detail": ["Create DHCP address pool", "Specify network address and subnet", "Specify excluded IP addresses", "Set the Default Gateway"] },
        { "code": "3.5", "title": "Configure DNS configuration",
          "detail": ["DNS configuration on router — ip name-server", "DNS configuration on server — IP address, Subnet Mask, Default Gateway, DNS server address, DNS service"] },
        { "code": "3.6", "title": "Perform basic network troubleshooting",
          "detail": ["Ping", "Traceroute", "Netstat", "Nslookup", "Ipconfig"] }
      ]
    },
    {
