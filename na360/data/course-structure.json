    {
      "id": "U1",
      "code": "1.0",
      "title": "Introduction to Network Administration",
      "clos": ["CLO1"],
      "domains": ["Network Administration Fundamentals"],
      "subtopics": [
        { "code": "1.1", "title": "Apply basic knowledge of network administration" },
        { "code": "1.2", "title": "Apply understanding of tasks in network administration",
